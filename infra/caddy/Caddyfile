# ──────────────────────────────────────────────────────────────────────────────
#  Caddy — internal reverse proxy in front of the OmniRoute blue/green slots.
#
#  Public TLS is terminated by Cloudflare; cloudflared reaches this server over
#  the private `edge` Docker network, so HTTP here is correct and :8080 is never
#  published to the VPS host.
# ──────────────────────────────────────────────────────────────────────────────
{
	auto_https off
	admin localhost:2019

	servers {
		# LLM responses stream for minutes. Caddy has no proxy read/write timeout
		# by default; this only caps how long a client may take to send headers.
		timeouts {
			read_header 30s
		}
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	route {
		# /healthz is the container's internal liveness probe and Caddy's own
		# upstream health probe target. Active health checks are issued directly
		# against the upstream and do NOT pass through this route, so hiding it
		# from public traffic costs nothing.
		#
		# /api/monitoring/health is intentionally NOT blocked: OmniRoute already
		# reduces it to {status, setupComplete} for unauthenticated callers
		# (GHSA-mvf8-qc78-5mxm), and it is the useful external uptime probe.
		@internal path /healthz
		respond @internal 404

		# Telegram webhook deliveries for the ops bot. The bot is a host systemd
		# service, not a container, so it survives a restart of this stack —
		# host.docker.internal is the extra_hosts mapping in compose.yml.
		#
		# Only the prefix is matched here: the secret path segment and the
		# X-Telegram-Bot-Api-Secret-Token header are both validated by the bot,
		# so no secret has to live in this file.
		@opsbot path /tg-ops/*
		reverse_proxy @opsbot host.docker.internal:20129

		import /etc/caddy/active.caddy
	}
}
