# ──────────────────────────────────────────────────────────────────────────────
#  Template for /opt/omniroute/.app.env  (chmod 600, never committed)
#
#  Copy to the VPS, fill in the secrets, and keep it out of git:
#     scp infra/app.env.example user@vps:/opt/omniroute/.app.env
#     ssh user@vps 'chmod 600 /opt/omniroute/.app.env && nano /opt/omniroute/.app.env'
#
#  Both slots (app-blue and app-green) read this same file, so a value here
#  applies to whichever slot is live. The full variable contract lives in the
#  repo's .env.example — this template carries only what production needs.
# ──────────────────────────────────────────────────────────────────────────────

# ── 1. REQUIRED SECRETS ───────────────────────────────────────────────────────
# Generate on the VPS; do NOT reuse dev values.
#   openssl rand -base64 48   -> JWT_SECRET
#   openssl rand -hex 32      -> API_KEY_SECRET
#
# Changing JWT_SECRET invalidates every dashboard session. Changing
# API_KEY_SECRET makes every provider API key already stored in SQLite
# undecryptable — set it once, before first boot, and never rotate it casually.
JWT_SECRET=
API_KEY_SECRET=

# Edge Gateway API key signing secret (HMAC-SHA256 for Key v2 format: sk-v2-...).
# Must match EDGE_API_KEY_SIGNING_SECRET secret on the Cloudflare Worker.
# Optional on standalone local installs (defaults to API_KEY_SECRET if unset).
# Generate:  openssl rand -hex 32
EDGE_API_KEY_SIGNING_SECRET=

# Initial dashboard password, consumed on first boot only. Change it in
# Dashboard → Settings → Security after logging in the first time.
INITIAL_PASSWORD=

# ── 2. NETWORK ────────────────────────────────────────────────────────────────
# Single-port mode: dashboard and the OpenAI-compatible API share this port.
# It matches `expose: 20128` in compose.yml and APP_PORT in deploy.sh — change
# all three together or not at all.
PORT=20128
HOSTNAME=0.0.0.0

# The public origin Cloudflare serves. Used server-side for OAuth callbacks and
# absolute URLs. NOTE: the client bundle inlines NEXT_PUBLIC_* at BUILD time, so
# setting it here covers server-side use; to also bake it into the browser
# bundle it must be passed at image build time.
NEXT_PUBLIC_BASE_URL=https://omniroute.example.com

# Caddy is the only thing that talks to the app, and it rewrites
# X-Forwarded-For from Cloudflare's CF-Connecting-IP. Trust LAN peers so the
# real client IP survives into rate limiting and logs.
OMNIROUTE_TRUST_PROXY=private

# ── 3. SECURITY ───────────────────────────────────────────────────────────────
# Sessions ride over Cloudflare HTTPS, so the cookie must carry Secure.
AUTH_COOKIE_SECURE=true

# The gateway is reachable from the public internet through the tunnel. Require
# an API key on /v1/* rather than leaving the proxy open.
REQUIRE_API_KEY=true

# ── 3b. SHUTDOWN ──────────────────────────────────────────────────────────────
# Deliberately NOT set here. SHUTDOWN_TIMEOUT_MS lives in compose.yml, next to
# stop_grace_period, because the two only make sense as a pair and must not
# drift apart. compose's `environment:` wins over this file anyway, so a value
# set here would be silently ignored.

# ── 4. STORAGE ────────────────────────────────────────────────────────────────
# DATA_DIR is already /app/data in the image and is bind-mounted to
# /opt/omniroute/data — do not override it here.
#
# The in-app auto-backup MUST stay disabled: during a blue/green overlap two
# slots would run it concurrently against one SQLite file. Backups are owned by
# infra/backup.sh on the host (cron, nightly, sqlite3 .backup + integrity check).
DISABLE_SQLITE_AUTO_BACKUP=true

# ── 5. REDIS ──────────────────────────────────────────────────────────────────
# Keeps rate-limit counters, the auth cache and the quota store outside the app
# process, so a blue→green switch does not reset them. `redis` is the compose
# service name on the private `backend` network.
REDIS_URL=redis://redis:6379

# ── 5b. CONCURRENCY & HEAVY REQUESTS ─────────────────────────────────────────
# Max concurrent heavy requests (raised from default 1 -> 5 to allow concurrent large-context turns)
OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=5
OMNIROUTE_CHAT_ADMISSION_HEALTHY_HEADROOM=5

# ── 6. PROVIDERS ──────────────────────────────────────────────────────────────
# Add provider credentials below, or configure them from the dashboard (they are
# then encrypted at rest with API_KEY_SECRET). See .env.example for the full list.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
