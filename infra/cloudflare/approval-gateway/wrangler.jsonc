{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omniroute-edge-approval-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "APPROVAL_DO",
        "class_name": "ApprovalDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ApprovalDurableObject"]
    }
  ],
  "vars": {
    "ENFORCE_APPROVAL": "true",
    "ALLOW_LEGACY_V1": "true",
    "FAIL_CLOSED": "true",
    "DEFAULT_APPROVAL_DURATION_SECONDS": "86400"
  },
  "observability": {
    "enabled": true
  }
}
