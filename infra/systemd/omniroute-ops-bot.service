# ──────────────────────────────────────────────────────────────────────────────
#  OmniRoute — Telegram Operations Bot Systemd Service Unit
#
#  Runs the private, owner-only Telegram operations bot as a dedicated,
#  unprivileged system user (omniroute-ops) with sandboxing and restricted
#  sudo capabilities for VPS operations helper commands.
#
#  Install:
#    sudo install -m 0644 infra/systemd/omniroute-ops-bot.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now omniroute-ops-bot.service
# ──────────────────────────────────────────────────────────────────────────────

[Unit]
Description=OmniRoute Telegram Operations Bot
After=network-online.target docker.service
Wants=network-online.target
Documentation=https://github.com/diegosouzapw/OmniRoute

# A bad /etc/omniroute/ops-bot.env makes ExecStartPre fail, and Restart=always
# with RestartSec=5s would then respawn python every 5 seconds forever. Cap it:
# five failures inside five minutes puts the unit in `failed` so the box stays
# quiet and `systemctl status` shows the real reason.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=omniroute-ops
Group=omniroute-ops
WorkingDirectory=/opt/omniroute/ops-bot

# Environment configuration
EnvironmentFile=/etc/omniroute/ops-bot.env

# Execution
ExecStartPre=/usr/bin/python3 -m current.main --check-config
ExecStart=/usr/bin/python3 -m current.main

# Lifecycle & Restart policy
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group

# Standard logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omniroute-ops-bot

# State and Runtime directories
StateDirectory=omniroute-ops
ConfigurationDirectory=omniroute
LogsDirectory=omniroute-ops

# Sandboxing & Security Hardening
# The bot calls one root-owned NOPASSWD helper through sudo. Several systemd
# sandbox directives implicitly enable NoNewPrivileges even when it is set to
# no, which makes every read-only/status command silently fall back to empty
# data. Keep filesystem isolation, while leaving those incompatible directives
# explicitly disabled. The helper still enforces its own fixed allowlist.
NoNewPrivileges=no
RestrictSUIDSGID=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectControlGroups=yes
ProtectKernelLogs=no
ProtectClock=no
ProtectHostname=no
RestrictRealtime=no
LockPersonality=no
MemoryDenyWriteExecute=no
RestrictNamespaces=no

# Resource ceilings. The bot idles at roughly 25 MB and a fraction of a percent
# of a core, so these only ever fire on a runaway loop or a leak.
# CPUQuota is deliberately not tighter: opsctl runs `docker compose` as a child
# of this unit, so it shares the cgroup, and a rollback throttled below its
# 420 s budget in the bot would time out mid-deployment.
MemoryMax=192M
CPUQuota=50%
TasksMax=64

# SystemCallArchitectures and RestrictAddressFamilies are deliberately omitted:
# systemd implements both with seccomp and implicitly enables NoNewPrivileges,
# preventing the NOPASSWD helper from gaining its tightly scoped root access.

# ProtectProc is deliberately NOT set. It remounts /proc with hidepid, and every
# privileged action here goes through setuid sudo -> opsctl, which is exactly the
# combination that is awkward to verify without breaking it. The payoff would be
# hiding other users' processes from a service whose job is reporting system
# state to its single owner; that is not worth risking the recovery path.

# Writable paths required for local sqlite database and state
ReadWritePaths=/var/lib/omniroute-ops /var/log/omniroute-ops

# Network access is required for outbound Telegram API and GitHub integration
PrivateNetwork=no

[Install]
WantedBy=multi-user.target
