# ──────────────────────────────────────────────────────────────────────────────
#  OmniRoute — Telegram Operations Bot Systemd Service Unit
#
#  Runs the private, owner-only Telegram operations bot as a dedicated,
#  unprivileged system user (omniroute-ops) with sandboxing and restricted
#  sudo capabilities for VPS operations helper commands.
#
#  Install:
#    sudo install -m 0644 infra/systemd/omniroute-ops-bot.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now omniroute-ops-bot.service
# ──────────────────────────────────────────────────────────────────────────────

[Unit]
Description=OmniRoute Telegram Operations Bot
After=network-online.target docker.service
Wants=network-online.target
Documentation=https://github.com/diegosouzapw/OmniRoute

# A bad /etc/omniroute/ops-bot.env makes ExecStartPre fail, and Restart=always
# with RestartSec=5s would then respawn python every 5 seconds forever. Cap it:
# five failures inside five minutes puts the unit in `failed` so the box stays
# quiet and `systemctl status` shows the real reason.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=omniroute-ops
Group=omniroute-ops
WorkingDirectory=/opt/omniroute/ops-bot

# Environment configuration
EnvironmentFile=/etc/omniroute/ops-bot.env

# Execution
ExecStartPre=/usr/bin/python3 -m current.main --check-config
ExecStart=/usr/bin/python3 -m current.main

# Lifecycle & Restart policy
Restart=always
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group

# Standard logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=omniroute-ops-bot

# State and Runtime directories
StateDirectory=omniroute-ops
ConfigurationDirectory=omniroute
LogsDirectory=omniroute-ops

# Sandboxing & Security Hardening
# Note: NoNewPrivileges must be 'no' to allow sudo helper execution (omniroute_opsctl)
NoNewPrivileges=no
RestrictSUIDSGID=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes

# Resource ceilings. The bot idles at roughly 25 MB and a fraction of a percent
# of a core, so these only ever fire on a runaway loop or a leak.
# CPUQuota is deliberately not tighter: opsctl runs `docker compose` as a child
# of this unit, so it shares the cgroup, and a rollback throttled below its
# 420 s budget in the bot would time out mid-deployment.
MemoryMax=192M
CPUQuota=50%
TasksMax=64

# Telegram and GitHub over TCP, docker/systemd/journald over unix sockets.
# AF_NETLINK is required as well: glibc's getaddrinfo enumerates interfaces
# through netlink, so dropping it breaks DNS resolution rather than hardening it.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ProtectProc=invisible

# Writable paths required for local sqlite database and state
ReadWritePaths=/var/lib/omniroute-ops /var/log/omniroute-ops

# Network access is required for outbound Telegram API and GitHub integration
PrivateNetwork=no

[Install]
WantedBy=multi-user.target
