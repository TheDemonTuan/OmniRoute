# ──────────────────────────────────────────────────────────────────────────────
#  OmniRoute — Telegram Operations Bot Configuration Example
#
#  Copy to /etc/omniroute/ops-bot.env with mode 0640:
#    sudo install -o root -g omniroute-ops -m 0640 infra/ops-bot.env.example /etc/omniroute/ops-bot.env
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot Credentials (MANDATORY) ───────────────────────────────────────
# Create via @BotFather in Telegram. Must follow standard token pattern (e.g. 123456789:ABCdef...).
OPS_TELEGRAM_BOT_TOKEN=

# ── Access Control (MANDATORY) ────────────────────────────────────────────────
# Exact numeric owner identity. Configure both; usernames are not authorization.
OPS_TELEGRAM_OWNER_USER_ID=
OPS_TELEGRAM_OWNER_CHAT_ID=

# Private chat enforcement is mandatory and cannot be disabled.

# ── Secondary PIN Authentication (Optional) ────────────────────────────────────
# Hexadecimal scrypt hash and salt generated with `security.py` (see the ops guide).
# Production deploy, sync-PR merge, rollback, and infrastructure restart require this PIN.
OPS_PIN_SCRYPT_HASH_B64=
OPS_PIN_SALT_B64=
# MAX_PIN_ATTEMPTS=3
# LOCKOUT_DURATION_SECONDS=900

# ── Helper Execution Path ─────────────────────────────────────────────────────
# Path to the allowlisted ops control helper.
# Default for systemd service using sudoers rule:
OPS_OPSCTL_PATH=/usr/local/sbin/omniroute-opsctl

# ── Storage & State ───────────────────────────────────────────────────────────
# SQLite database path for offsets, nonces, alert state, rate limits, and audit logs.
OPS_DB_PATH=/var/lib/omniroute-ops/ops.sqlite

# ── GitHub App Integration ────────────────────────────────────────────────────
OPS_GITHUB_APP_ID=
OPS_GITHUB_INSTALLATION_ID=
OPS_GITHUB_PRIVATE_KEY_FILE=/etc/omniroute/github-app.pem
OPS_GITHUB_REPO=TheDemonTuan/OmniRoute
OPS_GITHUB_UPSTREAM_REPO=diegosouzapw/OmniRoute
OPS_OMNIROUTE_MANAGEMENT_KEY=

# ── Resource & GitHub Actions Alerts ──────────────────────────────────────────
# One evaluation spawns `sudo opsctl system` and two GitHub API calls, so the
# interval is the main cost knob. 60s x debounce 5 still means a resource alert
# only fires after five sustained minutes.
OPS_ALERT_INTERVAL_SECONDS=60
OPS_ALERT_COOLDOWN_SECONDS=1800
OPS_ALERT_DEBOUNCE_CONSECUTIVE=5
OPS_ALERT_CPU_WARNING_PCT=85
OPS_ALERT_CPU_CRITICAL_PCT=95
OPS_ALERT_MEMORY_WARNING_PCT=85
OPS_ALERT_MEMORY_CRITICAL_PCT=95
OPS_ALERT_DISK_WARNING_PCT=80
OPS_ALERT_DISK_CRITICAL_PCT=90
# These fire on a run that is still queued/in_progress after this long. A normal
# production build takes 5-17 minutes, so the old 300s warning tripped on every
# healthy deploy — pure alert fatigue. Set above the real p99 build time.
OPS_ALERT_ACTIONS_DELAY_WARNING_SECONDS=1800
OPS_ALERT_ACTIONS_DELAY_CRITICAL_SECONDS=3600

# ── Update Intake Mode ────────────────────────────────────────────────────────
# webhook  Telegram POSTs updates to us through Cloudflare Tunnel -> Caddy.
# polling  The bot dials out and long-polls. Needs no inbound path at all.
#
# ESCAPE HATCH: webhook mode depends on cloudflared and Caddy being up — the very
# services this bot can restart. If inbound breaks, set polling here and
# `systemctl restart omniroute-ops-bot` to get the bot back over outbound only.
# Outgoing alerts keep working in either mode.
OPS_TELEGRAM_MODE=webhook

# Public URL Cloudflare routes to Caddy. The bot appends /tg-ops/<path secret>.
# IMPORTANT (Split-Domain): MUST be your API_HOST (e.g. https://omniroute-api.yourdomain.com).
# Do NOT use DASHBOARD_HOST because Cloudflare Access will block Telegram's automated webhooks.
OPS_WEBHOOK_PUBLIC_URL=https://omniroute-api.example.com

# Telegram echoes this back in X-Telegram-Bot-Api-Secret-Token on every delivery
# and it is the only proof a request really came from Telegram. 32-256 chars of
# [A-Za-z0-9_-]. Generate:  openssl rand -hex 32
OPS_WEBHOOK_SECRET_TOKEN=

# Secret segment of the URL path, so the endpoint is not even discoverable.
# 16-128 chars of [A-Za-z0-9_-]. Generate:  openssl rand -hex 16
OPS_WEBHOOK_PATH_SECRET=

# Caddy runs in a container, so it cannot reach 127.0.0.1 on the host. Bind the
# listener where the docker bridge can see it; bootstrap-vps.sh opens this port
# to 172.16.0.0/12 only. Use 127.0.0.1 if you ever run Caddy on the host.
OPS_WEBHOOK_HOST=0.0.0.0
OPS_WEBHOOK_PORT=20129
OPS_WEBHOOK_MAX_BODY_BYTES=1048576

# ── Polling & Network Settings (polling mode) ─────────────────────────────────
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_POLL_INTERVAL=0.5
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF=1.5

# ── Rate Limiting & Security ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
NONCE_TTL_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
