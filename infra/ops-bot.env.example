# ──────────────────────────────────────────────────────────────────────────────
#  OmniRoute — Telegram Operations Bot Configuration Example
#
#  Copy to /etc/omniroute/ops-bot.env with mode 0640:
#    sudo install -o root -g omniroute-ops -m 0640 infra/ops-bot.env.example /etc/omniroute/ops-bot.env
# ──────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot Credentials (MANDATORY) ───────────────────────────────────────
# Create via @BotFather in Telegram. Must follow standard token pattern (e.g. 123456789:ABCdef...).
OPS_TELEGRAM_BOT_TOKEN=

# ── Access Control (MANDATORY) ────────────────────────────────────────────────
# Exact numeric owner identity. Configure both; usernames are not authorization.
OPS_TELEGRAM_OWNER_USER_ID=
OPS_TELEGRAM_OWNER_CHAT_ID=

# Private chat enforcement is mandatory and cannot be disabled.

# ── Secondary PIN Authentication (Optional) ────────────────────────────────────
# Hexadecimal scrypt hash and salt generated with `security.py` (see the ops guide).
# Production deploy, sync-PR merge, rollback, and infrastructure restart require this PIN.
OPS_PIN_SCRYPT_HASH_B64=
OPS_PIN_SALT_B64=
# MAX_PIN_ATTEMPTS=3
# LOCKOUT_DURATION_SECONDS=900

# ── Helper Execution Path ─────────────────────────────────────────────────────
# Path to the allowlisted ops control helper.
# Default for systemd service using sudoers rule:
OPS_OPSCTL_PATH=/usr/local/sbin/omniroute-opsctl

# ── Storage & State ───────────────────────────────────────────────────────────
# SQLite database path for offsets, nonces, alert state, rate limits, and audit logs.
OPS_DB_PATH=/var/lib/omniroute-ops/ops.sqlite

# ── GitHub App Integration ────────────────────────────────────────────────────
OPS_GITHUB_APP_ID=
OPS_GITHUB_INSTALLATION_ID=
OPS_GITHUB_PRIVATE_KEY_FILE=/etc/omniroute/github-app.pem
OPS_GITHUB_REPO=TheDemonTuan/OmniRoute
OPS_GITHUB_UPSTREAM_REPO=diegosouzapw/OmniRoute
OPS_OMNIROUTE_MANAGEMENT_KEY=

# ── Resource & GitHub Actions Alerts ──────────────────────────────────────────
OPS_ALERT_INTERVAL_SECONDS=30
OPS_ALERT_COOLDOWN_SECONDS=1800
OPS_ALERT_DEBOUNCE_CONSECUTIVE=10
OPS_ALERT_CPU_WARNING_PCT=85
OPS_ALERT_CPU_CRITICAL_PCT=95
OPS_ALERT_MEMORY_WARNING_PCT=85
OPS_ALERT_MEMORY_CRITICAL_PCT=95
OPS_ALERT_DISK_WARNING_PCT=80
OPS_ALERT_DISK_CRITICAL_PCT=90
OPS_ALERT_ACTIONS_DELAY_WARNING_SECONDS=300
OPS_ALERT_ACTIONS_DELAY_CRITICAL_SECONDS=1800

# ── Polling & Network Settings ────────────────────────────────────────────────
TELEGRAM_POLL_TIMEOUT=30
TELEGRAM_POLL_INTERVAL=0.5
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BACKOFF=1.5

# ── Rate Limiting & Security ──────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
NONCE_TTL_SECONDS=300

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
